# Cloudinary Upload Widget (Unsigned preset)
# Cloudinary 대시보드 > Settings > Upload > Upload presets 에서 Unsigned preset 생성 후 입력
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# 포트원 V2 (관리자콘솔 > 결제 연동 에서 확인)
VITE_PORTONE_STORE_ID=store-your-store-id
VITE_PORTONE_CHANNEL_KEY=channel-key-your-channel-key
